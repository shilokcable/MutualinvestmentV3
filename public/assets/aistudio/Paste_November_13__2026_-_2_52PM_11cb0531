function readRows_(sh, startRow, numCols) {
  const last = sh.getLastRow();
  const count = last - startRow + 1;
  if (count < 1) return [];
  return sh.getRange(startRow, 1, count, numCols).getValues();
}

function date_(v) {
  if (!v) return '';
  const d = v instanceof Date ? v : new Date(v);
  if (isNaN(d.getTime())) return '';
  return Utilities.formatDate(d, CFG.TIMEZONE, 'dd-MM-yyyy');
}

function isoDate_(v) {
  if (!v) return '';
  const d = v instanceof Date ? v : new Date(v);
  if (isNaN(d.getTime())) return '';
  return Utilities.formatDate(d, CFG.TIMEZONE, 'yyyy-MM-dd');
}

function num_(v) {
  const n = Number(v);
  return isFinite(n) ? n : 0;
}

function money_(v) {
  return num_(v).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
}

function session_(token, requiredRole) {
  if (!token) throw new Error('Session expired. Please login again.');
  const cache = CacheService.getScriptCache();
  const raw = cache.get('sess_' + token);
  if (!raw) throw new Error('Session expired. Please login again.');
  const s = JSON.parse(raw);
  if (requiredRole && s.role !== requiredRole) throw new Error('Unauthorized.');
  cache.put('sess_' + token, raw, CFG.SESSION_SECONDS);
  return s;
}

function loginMember(memberId, password) {
  const sh = getSheet_(SHEETS.MEMBERS);
  const rows = readRows_(sh, 4, 7);
  const id = String(memberId || '').trim().toUpperCase();
  const pass = String(password || '').trim();
  const found = rows.find(r => String(r[0] || '').trim().toUpperCase() === id);
  if (!found) return {ok:false, message:'Member ID সঠিক নয়।'};
  if (String(found[4] || '').toLowerCase() === 'inactive') return {ok:false, message:'এই সদস্যের account inactive।'};
  if (String(found[6] || '').trim() !== pass) return {ok:false, message:'Password সঠিক নয়।'};
  const token = Utilities.getUuid();
  CacheService.getScriptCache().put('sess_' + token, JSON.stringify({role:'member', memberId:id}), CFG.SESSION_SECONDS);
  return {ok:true, token:token, role:'member', memberId:id, name:String(found[1] || '')};
}

function loginAdmin(pin) {
  const sh = getSheet_(SHEETS.SETTINGS);
  const stored = String(sh.getRange('B2').getDisplayValue()).trim();
  if (!stored || String(pin || '').trim() !== stored) return {ok:false, message:'Admin PIN সঠিক নয়।'};
  const token = Utilities.getUuid();
  CacheService.getScriptCache().put('sess_' + token, JSON.stringify({role:'admin'}), CFG.SESSION_SECONDS);
  return {ok:true, token:token, role:'admin'};
}

function logout(token) {
  if (token) CacheService.getScriptCache().remove('sess_' + token);
  return true;
}

function getMembers_() {
  return readRows_(getSheet_(SHEETS.MEMBERS), 4, 7).filter(r => r[0]);
}

function getTransactions_() {
  return readRows_(getSheet_(SHEETS.TX), 4, 6).filter(r => r[0] || r[1] || r[3]);
}

function ensureFdrSheet_() {
  const ss = getSS_();
  let sh = ss.getSheetByName(SHEETS.FDR);
  if (!sh) {
    sh = ss.insertSheet(SHEETS.FDR);
  }
  const headers = ['FDR ID','FDR Amount','FDR Date','Tenure (Months)','Maturity Date','Bank Name','FDR No','Status','Return Date','Returned Amount','Bank Approval/Reference','Note'];
  if (sh.getLastRow() < 1) {
    sh.getRange(1,1,1,headers.length).setValues([headers]);
  } else {
    const h = sh.getRange(1,1,1,headers.length).getValues()[0];
    if (String(h[0]||'') !== 'FDR ID') sh.getRange(1,1,1,headers.length).setValues([headers]);
  }
  sh.setFrozenRows(1);
  return sh;
}

function getFdrRows_() {
  const sh = ensureFdrSheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  return sh.getRange(2,1,last-1,12).getValues().filter(r => r[0] || r[1]);
}

function getBankRows_() {
  return readRows_(getSheet_(SHEETS.BANK), 2, 5).filter(r => r[0] || r[1] || r[2]);
}

function memberNet_(memberId, txRows) {
  const id = String(memberId).toUpperCase();
  return txRows.filter(r => String(r[1] || '').toUpperCase() === id).reduce((sum, r) => {
    const amount = num_(r[3]);
    return sum + (String(r[4] || '').toLowerCase().includes('withdraw') ? -amount : amount);
  }, 0);
}

function fdrStatus_(r) {
  if (r[8]) return 'Returned';
  const maturity = r[4];
  if (maturity && new Date(maturity) < new Date()) return 'Maturity Pending';
  return 'Active';
}

function accounts_() {
  const settings = getSheet_(SHEETS.SETTINGS);
  const tx = getTransactions_();
  const fdr = getFdrRows_();
  const bank = getBankRows_();
  const opening = num_(settings.getRange('B9').getValue());

  let memberNet = 0;
  tx.forEach(r => {
    const amount = num_(r[3]);
    memberNet += String(r[4] || '').toLowerCase().includes('withdraw') ? -amount : amount;
  });

  let bankNet = 0;
  bank.forEach(r => {
    const type = String(r[1] || '');
    const amount = num_(r[2]);
    if (type === 'Bank Credit' || type === 'Other Credit') bankNet += amount;
    if (type === 'Withdrawal' || type === 'Other Expense') bankNet -= amount;
  });

  let placed = 0, returned = 0, activeFdr = 0, pendingFdr = 0;
  fdr.forEach(r => {
    const amount = num_(r[1]);
    const status = fdrStatus_(r);
    placed += amount;
    if (r[8]) returned += num_(r[9]);
    if (status === 'Active' || status === 'Maturity Pending') {
      activeFdr += amount;
      if (status === 'Maturity Pending') pendingFdr++;
    }
  });

  const mainBank = opening + memberNet + bankNet - placed + returned;
  const totalInstitutional = mainBank + activeFdr;
  return {opening, memberNet, bankNet, placed, returned, mainBank, fdrBalance:activeFdr, totalInstitutional, activeFdrCount: fdr.filter(r=>fdrStatus_(r)!=='Returned').length, pendingFdr};
}

function dashboard(token) {
  const s = session_(token);
  const members = getMembers_();
  const tx = getTransactions_();
  const fdr = getFdrRows_();

  if (s.role === 'member') {
    const me = members.find(r => String(r[0]).toUpperCase() === String(s.memberId).toUpperCase());
    if (!me) throw new Error('Member not found.');
    const mine = tx.filter(r => String(r[1]).toUpperCase() === String(s.memberId).toUpperCase());
    const transactions = mine.map(r => ({date:date_(r[0]), type:String(r[4] || 'Deposit'), amount:num_(r[3]), note:String(r[5] || '')}));
    const total = memberNet_(s.memberId, tx);
    // Institutional account summary is read-only for members.
    // It is NOT tied to the member's individual balance.
    const acc = accounts_();
    return {
      ok:true, role:'member', memberId:s.memberId, name:String(me[1] || ''), mobile:String(me[2] || ''), total:total,
      mainBank:acc.mainBank,
      fdrBalance:acc.fdrBalance,
      totalInstitutional:acc.totalInstitutional,
      activeFdr:acc.activeFdrCount,
      pendingFdr:acc.pendingFdr,
      kyc:kycStatusForMember_(s.memberId),
      transactions:transactions,
      accountStatus:String(me[4] || 'Active')
    };
  }

  const acc = accounts_();
  const nowYM = Utilities.formatDate(new Date(), CFG.TIMEZONE, 'yyyy-MM');
  const thisMonth = tx.reduce((sum,r) => {
    if (!r[0]) return sum;
    const ym = Utilities.formatDate(new Date(r[0]), CFG.TIMEZONE, 'yyyy-MM');
    if (ym !== nowYM) return sum;
    const a=num_(r[3]);
    return sum + (String(r[4]||'').toLowerCase().includes('withdraw') ? -a : a);
  },0);

  const memberList = members.map(r => ({id:String(r[0]), name:String(r[1]||''), mobile:String(r[2]||''), status:String(r[4]||''), total:memberNet_(r[0],tx)}));
  const fdrList = fdr.map(r => ({id:String(r[0]||''), amount:num_(r[1]), date:date_(r[2]), tenure:r[3]||'', maturity:date_(r[4]), bank:String(r[5]||''), no:String(r[6]||''), status:fdrStatus_(r), returnDate:date_(r[8]), returned:num_(r[9]), ref:String(r[10]||''), note:String(r[11]||'')}));
  const recent = tx.slice(-12).reverse().map(r => ({date:date_(r[0]), memberId:String(r[1]||''), name:String(r[2]||''), amount:num_(r[3]), type:String(r[4]||''), note:String(r[5]||'')}));

  return {ok:true, role:'admin', memberCount:members.length, totalDeposit:memberList.reduce((a,m)=>a+m.total,0), thisMonth, mainBank:acc.mainBank, fdrBalance:acc.fdrBalance, totalInstitutional:acc.totalInstitutional, activeFdr:acc.activeFdrCount, pendingFdr:acc.pendingFdr, members:memberList, fdrList, recent, kycRequests:getKycRequests_()};
}

function saveTransaction(token, data) {
  session_(token,'admin');
  const memberId = String(data && data.memberId || '').trim().toUpperCase();
  const amount = num_(data && data.amount);
  const type = String(data && data.type || 'Monthly Deposit').trim();
  if (!memberId) throw new Error('Member ID নির্বাচন করুন।');
  if (amount <= 0) throw new Error('Amount সঠিকভাবে দিন।');
  const member = getMembers_().find(r => String(r[0]).toUpperCase() === memberId);
  if (!member) throw new Error('Member ID পাওয়া যায়নি।');
  if (String(member[4]||'').toLowerCase() === 'inactive') throw new Error('Inactive member-এর transaction করা যাবে না।');
  if (type.toLowerCase().includes('withdraw')) {
    const current = memberNet_(memberId, getTransactions_());
    if (amount > current) throw new Error('এই সদস্যের বর্তমান নেট জমার চেয়ে Withdrawal বেশি হতে পারবে না।');
  }
  const sh=getSheet_(SHEETS.TX);
  const dt=data.date ? new Date(data.date + 'T00:00:00') : new Date();
  if (isNaN(dt.getTime())) throw new Error('তারিখ সঠিক নয়।');
  sh.appendRow([dt,memberId,'',amount,type,String(data.note||'')]);
  const row=sh.getLastRow();
  sh.getRange(row,3).setFormula(`=IFERROR(VLOOKUP(B${row},Members!$A$4:$B$25,2,FALSE),"")`);
  return {ok:true};
}

function currentMainBank_() { return accounts_().mainBank; }

function saveFDR(token, data) {
  session_(token,'admin');
  const amount=num_(data && data.amount);
  const tenure=num_(data && data.tenure);
  if (amount<=0) throw new Error('FDR Amount সঠিকভাবে দিন।');
  if (!data.date) throw new Error('FDR Date দিন।');
  if (tenure<=0) throw new Error('Tenure (months) দিন।');
  const main=currentMainBank_();
  if (amount>main) throw new Error('Main Bank Balance যথেষ্ট নয়। বর্তমান Main Bank: ৳ ' + money_(main));
  const sh=ensureFdrSheet_();
  const dt=new Date(data.date+'T00:00:00');
  if (isNaN(dt.getTime())) throw new Error('FDR Date সঠিক নয়।');
  const stamp=Utilities.formatDate(new Date(),CFG.TIMEZONE,'yyyyMMdd-HHmmss');
  const id='FDR-'+stamp;
  const row=sh.getLastRow()+1;
  sh.getRange(row,1,1,12).setValues([[id,amount,dt,tenure,'',String(data.bank||''),String(data.fdrNo||''),'','','',String(data.ref||''),String(data.note||'')]]);
  sh.getRange(row,5).setFormula(`=IF(OR(C${row}="",D${row}=""),"",EDATE(C${row},D${row}))`);
  sh.getRange(row,8).setFormula(`=IF(B${row}="","",IF(I${row}<>"","Returned",IF(E${row}<TODAY(),"Maturity Pending","Active")))`);
  SpreadsheetApp.flush();
  return {ok:true,id:id,mainBankAfter:accounts_().mainBank,fdrBalance:accounts_().fdrBalance};
}

function returnFDR(token, data) {
  session_(token,'admin');
  const id=String(data && data.fdrId || '');
  const returned=num_(data && data.returnedAmount);
  if (!id) throw new Error('FDR নির্বাচন করুন।');
  if (returned<=0) throw new Error('Returned Amount সঠিকভাবে দিন।');
  const sh=ensureFdrSheet_();
  const rows=readRows_(sh,2,12);
  for (let i=0;i<rows.length;i++) {
    if (String(rows[i][0])===id) {
      if (rows[i][8]) throw new Error('এই FDR ইতিমধ্যে Returned।');
      const row=i+2;
      sh.getRange(row,9).setValue(data.returnDate ? new Date(data.returnDate+'T00:00:00') : new Date());
      sh.getRange(row,10).setValue(returned);
      if (data.ref !== undefined) sh.getRange(row,11).setValue(String(data.ref||''));
      if (data.note !== undefined) sh.getRange(row,12).setValue(String(data.note||''));
      return {ok:true};
    }
  }
  throw new Error('FDR ID পাওয়া যায়নি।');
}

function updateMember(token, data) {
  session_(token,'admin');
  const id=String(data && data.memberId || '').trim().toUpperCase();
  if (!id) throw new Error('Member ID দিন।');
  const sh=getSheet_(SHEETS.MEMBERS);
  const rows=readRows_(sh,4,7);
  for (let i=0;i<rows.length;i++) {
    if (String(rows[i][0]).toUpperCase()===id) {
      const row=i+4;
      if (data.name!==undefined) sh.getRange(row,2).setValue(String(data.name||''));
      if (data.mobile!==undefined) sh.getRange(row,3).setValue(String(data.mobile||''));
      if (data.status!==undefined) sh.getRange(row,5).setValue(String(data.status||'Active'));
      if (data.password!==undefined && String(data.password).trim()!=='') sh.getRange(row,7).setValue(String(data.password).trim());
      return {ok:true};
    }
  }
  throw new Error('Member ID পাওয়া যায়নি।');
}

function saveBankEntry(token,data) {
  session_(token,'admin');
  const amount=num_(data && data.amount);
  if (amount<=0) throw new Error('Amount সঠিকভাবে দিন।');
  const type=String(data && data.type || '').trim();
  const allowed=['Bank Credit','Other Credit','Withdrawal','Other Expense'];
  if (allowed.indexOf(type)<0) throw new Error('Bank transaction type সঠিক নয়।');
  const sh=getSheet_(SHEETS.BANK);
  const dt=data.date ? new Date(data.date+'T00:00:00') : new Date();
  sh.appendRow([dt,type,amount,String(data.reference||''),String(data.note||'')]);
  return {ok:true};
}

function getStatement(token) {
  const s=session_(token,'member');
  const d=dashboard(token);
  return {name:d.name,memberId:d.memberId,mobile:d.mobile,total:d.total,mainBank:d.mainBank,fdrBalance:d.fdrBalance,totalInstitutional:d.totalInstitutional,activeFdr:d.activeFdr,pendingFdr:d.pendingFdr,transactions:d.transactions};
}
