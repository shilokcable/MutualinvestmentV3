.member-hero{background:linear-gradient(135deg,#ffffff,#eef5ff);border:1px solid #cfe0f5}.member-name{font-size:25px;margin:0;color:var(--navy)}.balance{font-size:36px;font-weight:900;color:var(--green);margin:8px 0}.empty{text-align:center;padding:28px;color:var(--muted)}.toast{position:fixed;right:20px;bottom:20px;background:#17324b;color:#fff;padding:13px 16px;border-radius:12px;display:none;z-index:100}.modal{position:fixed;inset:0;background:rgba(9,30,55,.5);display:flex;align-items:center;justify-content:center;padding:20px;z-index:99}.modal-box{width:430px;max-width:100%;background:#fff;border-radius:20px;padding:22px;box-shadow:0 20px 70px rgba(0,0,0,.25)}
