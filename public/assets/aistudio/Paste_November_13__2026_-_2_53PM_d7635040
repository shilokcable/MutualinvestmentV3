<div id="cropModal" class="modal hidden"><div class="crop-box"><div class="section-title"><div><h3 style="color:#fff;margin:0">Crop Photo</h3><span class="crop-help">Box-এর ভিতরের অংশটি রাখা হবে। Box টেনে সরান বা কোণা ধরে resize করুন।</span></div><button class="secondary" onclick="cancelCrop()">×</button></div><div class="crop-stage"><canvas id="cropCanvas" width="420" height="320"></canvas></div><div class="crop-actions"><button class="secondary" onclick="cancelCrop()">Cancel</button><button class="green" onclick="useCrop()">✓ Crop & Use</button></div></div></div>
<script>
let token='', role='', dataCache=null;
const LOGO='data:image/jpeg;base64,';
function msg(t, bad=false){const x=document.getElementById('loginMsg');x.textContent=t||'';x.style.color=bad?'#d64545':'#1769e0'}
function switchLogin(type){document.getElementById('memberForm').classList.toggle('hidden',type!=='member');document.getElementById('adminForm').classList.toggle('hidden',type!=='admin');document.getElementById('memberTab').classList.toggle('active',type==='member');document.getElementById('adminTab').classList.toggle('active',type==='admin');msg('')}
function memberLogin(){const id=document.getElementById('memberId').value.trim(),p=document.getElementById('memberPass').value.trim();if(!id||!p)return msg('Member ID এবং Password দিন।',true);msg('Login হচ্ছে...');google.script.run.withSuccessHandler(r=>{if(!r.ok)return msg(r.message,true);token=r.token;role='member';loadDashboard()}).withFailureHandler(e=>msg('Login Error: '+(e.message||e),true)).loginMember(id,p)}
function adminLogin(){const p=document.getElementById('adminPin').value.trim();if(!p)return msg('Admin PIN দিন।',true);msg('Admin login হচ্ছে...');google.script.run.withSuccessHandler(r=>{if(!r.ok)return msg(r.message,true);token=r.token;role='admin';loadDashboard()}).withFailureHandler(e=>msg('Login Error: '+(e.message||e),true)).loginAdmin(p)}
function loadDashboard(){google.script.run.withSuccessHandler(r=>{dataCache=r;document.getElementById('loginView').classList.add('hidden');document.getElementById('app').style.display='block';render(r);if(r.role==='member' && (!r.kyc || !r.kyc.completed))setTimeout(openKyc,450)}).withFailureHandler(e=>{token='';role='';msg('Dashboard Error: '+(e.message||e),true)}).dashboard(token)}
function money(n){return Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function render(d){document.getElementById('dashboard').innerHTML=d.role==='member'?memberView(d):adminView(d);window.scrollTo({top:0,behavior:'smooth'})}
function metric(label,value,cls=''){return `<div class="card metric ${cls}"><div class="label">${label}</div><div class="value">${value}</div></div>`}
function memberView(d){const ks=d.kyc&&d.kyc.completed;const photo=d.kyc&&d.kyc.photoData;const req=d.kyc&&d.kyc.requestStatus;return `<div class="card member-hero"><div class="section-title"><div style="display:flex;align-items:center;gap:12px;min-width:0"><div>${photo?`<img class="member-photo" src="${photo}">`:`<div class="member-photo" style="display:flex;align-items:center;justify-content:center;font-size:26px">👤</div>`}</div><div style="min-width:0"><div class="muted">Member Account</div><h2 class="member-name" style="font-size:22px">${esc(d.name)} <span class="muted">${esc(d.memberId)}</span></h2><div class="muted">${esc(d.mobile||'')} • <span class="pill">${esc(d.accountStatus)}</span> ${ks?'<span class="kyc-status done">✓ KYC Completed</span>':'<span class="kyc-status">KYC Pending</span>'}</div></div></div><div class="actions no-print"><button class="profile-chip" onclick="openProfile()">👤 My Profile</button>${!ks?`<button class="kyc-btn" onclick="openKyc()">Complete KYC</button>`:`<button class="kyc-download" onclick="downloadKycPdf()">📄 Download KYC PDF</button><button class="secondary" onclick="openPhotoModal()">📷 Change Profile Photo</button><button class="secondary" onclick="openRequest()">✉️ Request Update</button>`}<button onclick="printStatement()">Print / Save PDF</button><button class="secondary" onclick="doLogout()">Logout</button></div></div><div class="balance">৳ ${money(d.total)}</div><div class="muted">আপনার বর্তমান নেট জমা</div>${req?`<div class="kyc-note" style="margin-top:12px">Update Request: <b>${esc(req)}</b> • Status: <b>${esc(d.kyc.requestStatus||'Pending')}</b></div>`:''}</div><div class="section grid">${metric('মোট লেনদেন',d.transactions.length)}${metric('Account Status',esc(d.accountStatus))}</div><div class="section"><div class="section-title"><div><h3>প্রতিষ্ঠানের বর্তমান আর্থিক অবস্থা</h3><span class="muted">শুধু দেখার জন্য • আপনার ব্যক্তিগত জমার অংশ নয়</span></div></div><div class="grid">${metric('Total Bank Balance','৳ '+money(d.mainBank),'big')}${metric('FDR Balance','৳ '+money(d.fdrBalance),'gold')}${metric('Total Institutional Funds','৳ '+money(d.totalInstitutional),'green')}${metric('Active FDR',d.activeFdr)}${metric('Maturity Pending',d.pendingFdr,'gold')}</div></div><div class="section card"><div class="section-title"><h3>আপনার লেনদেন</h3><span class="muted">Only your account is visible</span></div>${txTable(d.transactions)}</div>`}
function txTable(rows){if(!rows.length)return '<div class="empty">এখনও কোনো লেনদেন পাওয়া যায়নি।</div>';return `<div class="table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Note</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.type)}</td><td>৳ ${money(x.amount)}</td><td>${esc(x.note)}</td></tr>`).join('')}</tbody></table></div>`}
function adminView(d){return `<div class="grid">${metric('মোট সদস্য',d.memberCount)}${metric('মোট সদস্যের নেট জমা','৳ '+money(d.totalDeposit),'green')}${metric('Main Bank Balance','৳ '+money(d.mainBank),'big')}${metric('FDR Balance','৳ '+money(d.fdrBalance),'gold')}</div><div class="section grid">${metric('Total Institutional Funds','৳ '+money(d.totalInstitutional),'green')}${metric('এই মাসের নেট জমা','৳ '+money(d.thisMonth))}${metric('Active / Pending FDR',d.activeFdr)}${metric('Maturity Pending',d.pendingFdr,'gold')}</div><div class="section grid2"><div class="card"><div class="section-title"><h3>নতুন Deposit / Withdrawal</h3><span class="muted">Member transaction</span></div><div class="form-grid"><input id="txDate" type="date"><select id="txType"><option>Monthly Deposit</option><option>Special Deposit</option><option>Withdrawal</option></select><select id="txMember">${d.members.map(m=>`<option value="${esc(m.id)}">${esc(m.id)} — ${esc(m.name)}</option>`).join('')}</select><input id="txAmount" type="number" min="0" placeholder="Amount"><input id="txNote" class="wide" placeholder="Note / Bank Reference"></div><div class="actions" style="margin-top:10px"><button onclick="saveTx()">Save Transaction</button></div></div><div class="card"><div class="section-title"><h3>Institutional FDR</h3><span class="muted">In MUTUAL INVESTMENT name</span></div><div class="form-grid"><input id="fdrDate" type="date"><input id="fdrAmount" type="number" min="0" placeholder="FDR Amount"><input id="fdrTenure" type="number" min="1" placeholder="Tenure (months)"><input id="fdrBank" placeholder="Bank Name"><input id="fdrNo" placeholder="FDR No"><input id="fdrRef" placeholder="Reference"></div><div class="actions" style="margin-top:10px"><button class="green" onclick="saveFdr()">Create FDR</button></div></div></div><div class="section card"><div class="section-title"><h3>FDR Maturity / Return</h3><span class="muted">Return money to Main Bank</span></div><div class="form-grid"><select id="returnFdr">${d.fdrList.filter(x=>x.status!=='Returned').map(x=>`<option value="${esc(x.id)}">${esc(x.id)} — ৳ ${money(x.amount)} — ${esc(x.status)}</option>`).join('')}</select><input id="returnDate" type="date"><input id="returnAmount" type="number" min="0" placeholder="Returned Amount"><input id="returnRef" class="wide" placeholder="Bank Approval / Reference"></div><div class="actions" style="margin-top:10px"><button class="gold" onclick="returnFdr()">Save FDR Return</button></div></div><div class="section card"><div class="section-title"><h3>Members</h3><span class="muted">Admin can edit member profile</span></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Mobile</th><th>Net Deposit</th><th>Status</th><th>Action</th></tr></thead><tbody>${d.members.map(m=>`<tr><td>${esc(m.id)}</td><td>${esc(m.name)}</td><td>${esc(m.mobile)}</td><td>৳ ${money(m.total)}</td><td><span class="pill ${m.status.toLowerCase()==='inactive'?'red':''}">${esc(m.status)}</span></td><td><button class="secondary" onclick='openEdit(${JSON.stringify(m)})'>Edit</button></td></tr>`).join('')}</tbody></table></div></div><div class="section card"><div class="section-title"><h3>Recent Transactions</h3></div>${recentTable(d.recent)}</div><div class="section card"><div class="section-title"><h3>Institutional FDR</h3><span class="muted">FDR placement reduces Main Bank; return increases Main Bank</span></div>${fdrTable(d.fdrList)}</div><div class="section card"><div class="section-title"><h3>📩 KYC Update Requests</h3><span class="muted">Member requests</span></div>${kycRequestsTable(d.kycRequests||[])}</div>`}
function recentTable(rows){if(!rows.length)return '<div class="empty">No transactions yet.</div>';return `<div class="table-wrap"><table><thead><tr><th>Date</th><th>Member</th><th>Name</th><th>Type</th><th>Amount</th><th>Note</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.memberId)}</td><td>${esc(x.name)}</td><td>${esc(x.type)}</td><td>৳ ${money(x.amount)}</td><td>${esc(x.note)}</td></tr>`).join('')}</tbody></table></div>`}
function fdrTable(rows){if(!rows.length)return '<div class="empty">কোনো FDR নেই।</div>';return `<div class="table-wrap"><table><thead><tr><th>FDR ID</th><th>Amount</th><th>Date</th><th>Maturity</th><th>Bank</th><th>FDR No</th><th>Status</th><th>Return</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.id)}</td><td>৳ ${money(x.amount)}</td><td>${esc(x.date)}</td><td>${esc(x.maturity)}</td><td>${esc(x.bank)}</td><td>${esc(x.no)}</td><td><span class="pill ${x.status==='Maturity Pending'?'warn':''}">${esc(x.status)}</span></td><td>${x.returnDate?esc(x.returnDate)+' / ৳ '+money(x.returned):'-'}</td></tr>`).join('')}</tbody></table></div>`}
function saveTx(){const payload={date:document.getElementById('txDate').value,memberId:document.getElementById('txMember').value,amount:document.getElementById('txAmount').value,type:document.getElementById('txType').value,note:document.getElementById('txNote').value};google.script.run.withSuccessHandler(()=>{toast('Transaction saved');loadDashboard()}).withFailureHandler(e=>alert(e.message||e)).saveTransaction(token,payload)}
function saveFdr(){const payload={date:document.getElementById('fdrDate').value,amount:document.getElementById('fdrAmount').value,tenure:document.getElementById('fdrTenure').value,bank:document.getElementById('fdrBank').value,fdrNo:document.getElementById('fdrNo').value,ref:document.getElementById('fdrRef').value};if(!payload.date)return alert('FDR Date দিন।');if(Number(payload.amount)<=0)return alert('FDR Amount দিন।');if(Number(payload.tenure)<=0)return alert('Tenure (months) দিন।');const btn=document.querySelector('button[onclick="saveFdr()"]');if(btn)btn.disabled=true;google.script.run.withSuccessHandler(r=>{if(btn)btn.disabled=false;toast('FDR created successfully: '+r.id);loadDashboard()}).withFailureHandler(e=>{if(btn)btn.disabled=false;alert((e&&e.message)||e)}).saveFDR(token,payload)}
function returnFdr(){const payload={fdrId:document.getElementById('returnFdr').value,returnDate:document.getElementById('returnDate').value,returnedAmount:document.getElementById('returnAmount').value,ref:document.getElementById('returnRef').value};if(!payload.fdrId)return alert('কোনো Active FDR নেই।');google.script.run.withSuccessHandler(()=>{toast('FDR returned to Main Bank');loadDashboard()}).withFailureHandler(e=>alert(e.message||e)).returnFDR(token,payload)}
function openEdit(m){document.getElementById('editId').value=m.id;document.getElementById('editName').value=m.name||'';document.getElementById('editMobile').value=m.mobile||'';document.getElementById('editStatus').value=m.status||'Active';document.getElementById('editPassword').value='';document.getElementById('modal').classList.remove('hidden')}
function closeModal(){document.getElementById('modal').classList.add('hidden')}
function saveMemberEdit(){const payload={memberId:document.getElementById('editId').value,name:document.getElementById('editName').value,mobile:document.getElementById('editMobile').value,status:document.getElementById('editStatus').value,password:document.getElementById('editPassword').value};google.script.run.withSuccessHandler(()=>{closeModal();toast('Member updated');loadDashboard()}).withFailureHandler(e=>alert(e.message||e)).updateMember(token,payload)}
function setKycMsg(t,bad=false){const x=document.getElementById('kycMsg');if(x){x.textContent=t||'';x.style.color=bad?'#d64545':'#1769e0'}}
const cropResults={};let cropState=null,kycStep=1,kycEditMode=false;
function showPreview(id,dataUrl,label){const box=document.getElementById(id);if(!box)return;box.innerHTML=dataUrl?`<img src="${dataUrl}"><span class="muted">✓ Ready${label?' • '+esc(label):''}</span>`:''}
function readFileData(file){return new Promise((resolve,reject)=>{if(!file)return resolve('');const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)})}
function pickCamera(id,facing){const el=document.getElementById(id);if(!el)return;el.setAttribute('capture',facing||'environment');el.value='';el.onchange=()=>handleKycFile(el,previewIdFor(id));el.click()}
function pickGallery(id){const el=document.getElementById(id);if(!el)return;el.removeAttribute('capture');el.value='';el.onchange=()=>handleKycFile(el,previewIdFor(id));el.click()}
function previewIdFor(inputId){const map={kycShareNidFront:'previewShareNidFront',kycShareNidBack:'previewShareNidBack',kycMemberPhoto:'previewMemberPhoto',kycTinFile:'previewTinFile',kycPassportFile:'previewPassportFile',kycNomNidFront:'previewNomNidFront',kycNomNidBack:'previewNomNidBack',kycNomineePhoto:'previewNomineePhoto',profilePhotoInput:'profilePhotoPreview'};return map[inputId]}
async function pdfFirstPageToImage(file){if(!window.pdfjsLib)throw new Error('PDF reader load হয়নি। Internet connection check করুন।');const buf=await file.arrayBuffer();const pdf=await pdfjsLib.getDocument({data:buf}).promise;const page=await pdf.getPage(1);const base=page.getViewport({scale:1});const scale=Math.min(1.65,1400/Math.max(base.width,base.height));const vp=page.getViewport({scale:scale});const c=document.createElement('canvas');c.width=Math.ceil(vp.width);c.height=Math.ceil(vp.height);await page.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;return c.toDataURL('image/jpeg',.82)}
async function handleKycFile(input,previewId){const file=input.files&&input.files[0];if(!file)return;previewId=previewId||previewIdFor(input.id);try{if(file.type==='application/pdf'){const data=await pdfFirstPageToImage(file);cropResults[input.id]=data;showPreview(previewId,data,'PDF Page 1');return;}openCropper(file,input.id,previewId);}catch(e){document.getElementById(previewId).innerHTML='<span class="muted">PDF/Image load error: '+esc(e.message||e)+'</span>';}}
function openCropper(file,targetId,previewId){const r=new FileReader();r.onload=()=>{const img=new Image();img.onload=()=>{const canvas=document.getElementById('cropCanvas');canvas.width=Math.min(720,Math.max(320,window.innerWidth-28));canvas.height=Math.min(520,Math.max(260,window.innerHeight-190));const scale=Math.min(canvas.width/img.width,canvas.height/img.height);const dw=img.width*scale,dh=img.height*scale,ox=(canvas.width-dw)/2,oy=(canvas.height-dh)/2;let w=dw*.78,h=dh*.78;cropState={img,targetId,previewId,scale,ox,oy,dw,dh,rect:{x:ox+(dw-w)/2,y:oy+(dh-h)/2,w,h},mode:null,start:null};drawCrop();document.getElementById('cropModal').classList.remove('hidden')};img.src=r.result};r.readAsDataURL(file)}
function drawCrop(){if(!cropState)return;const c=document.getElementById('cropCanvas'),ctx=c.getContext('2d'),q=cropState;ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle='#000';ctx.fillRect(0,0,c.width,c.height);ctx.drawImage(q.img,q.ox,q.oy,q.dw,q.dh);ctx.fillStyle='rgba(0,0,0,.52)';ctx.fillRect(0,0,c.width,c.height);const r=q.rect;ctx.save();ctx.beginPath();ctx.rect(r.x,r.y,r.w,r.h);ctx.clip();ctx.drawImage(q.img,q.ox,q.oy,q.dw,q.dh);ctx.restore();ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.strokeRect(r.x,r.y,r.w,r.h);ctx.fillStyle='#fff';[[r.x,r.y],[r.x+r.w,r.y],[r.x,r.y+r.h],[r.x+r.w,r.y+r.h]].forEach(p=>{ctx.beginPath();ctx.arc(p[0],p[1],8,0,Math.PI*2);ctx.fill()})}
function cropPoint(e){const c=document.getElementById('cropCanvas'),b=c.getBoundingClientRect(),src=e.touches&&e.touches[0]?e.touches[0]:e;return{x:(src.clientX-b.left)*c.width/b.width,y:(src.clientY-b.top)*c.height/b.height}}
function cropDown(e){if(!cropState)return;e.preventDefault();const p=cropPoint(e),r=cropState.rect,near=(x,y)=>Math.hypot(p.x-x,p.y-y)<22;cropState.mode=near(r.x+r.w,r.y+r.h)?'se':near(r.x,r.y)?'nw':near(r.x+r.w,r.y)?'ne':near(r.x,r.y+r.h)?'sw':(p.x>=r.x&&p.x<=r.x+r.w&&p.y>=r.y&&p.y<=r.y+r.h)?'move':null;if(cropState.mode)cropState.start={p:{...p},rect:{...r}}}
function cropMove(e){if(!cropState||!cropState.mode)return;e.preventDefault();const p=cropPoint(e),q=cropState,s=q.start,r=s.rect,dx=p.x-s.p.x,dy=p.y-s.p.y;let nr={...r};if(q.mode==='move'){nr.x=Math.max(q.ox,Math.min(q.ox+q.dw-r.w,r.x+dx));nr.y=Math.max(q.oy,Math.min(q.oy+q.dh-r.h,r.y+dy));}else{let x=r.x,y=r.y,w=r.w,h=r.h;if(q.mode.includes('e'))w=r.w+dx;if(q.mode.includes('s'))h=r.h+dy;if(q.mode.includes('w')){x=r.x+dx;w=r.w-dx}if(q.mode.includes('n')){y=r.y+dy;h=r.h-dy}w=Math.max(30,w);h=Math.max(30,h);if(x<q.ox){w-=q.ox-x;x=q.ox}if(y<q.oy){h-=q.oy-y;y=q.oy}if(x+w>q.ox+q.dw)w=q.ox+q.dw-x;if(y+h>q.oy+q.dh)h=q.oy+q.dh-y;nr={x,y,w,h}}q.rect=nr;drawCrop()}
function cropUp(){if(cropState)cropState.mode=null}
function useCrop(){if(!cropState)return;const q=cropState,r=q.rect,c=document.getElementById('cropCanvas');const sx=(r.x-q.ox)/q.scale,sy=(r.y-q.oy)/q.scale,sw=r.w/q.scale,sh=r.h/q.scale;const out=document.createElement('canvas'),max=1800,sc=Math.min(1,max/Math.max(sw,sh));out.width=Math.max(1,Math.round(sw*sc));out.height=Math.max(1,Math.round(sh*sc));out.getContext('2d').drawImage(q.img,sx,sy,sw,sh,0,0,out.width,out.height);const data=out.toDataURL('image/jpeg',.92);cropResults[q.targetId]=data;showPreview(q.previewId,data,'Cropped');document.getElementById('cropModal').classList.add('hidden');cropState=null}
function cancelCrop(){document.getElementById('cropModal').classList.add('hidden');cropState=null}
const cropCanvas=document.getElementById('cropCanvas');if(cropCanvas){cropCanvas.addEventListener('pointerdown',cropDown);cropCanvas.addEventListener('pointermove',cropMove);cropCanvas.addEventListener('pointerup',cropUp);cropCanvas.addEventListener('pointercancel',cropUp);cropCanvas.addEventListener('touchstart',cropDown,{passive:false});cropCanvas.addEventListener('touchmove',cropMove,{passive:false});cropCanvas.addEventListener('touchend',cropUp,{passive:false});}
function setupKycPreviews(){Object.keys({kycShareNidFront:1,kycShareNidBack:1,kycMemberPhoto:1,kycTinFile:1,kycPassportFile:1,kycNomNidFront:1,kycNomNidBack:1,kycNomineePhoto:1}).forEach(id=>{const el=document.getElementById(id);if(el&&!el.dataset.ready){el.dataset.ready='1';el.addEventListener('change',()=>handleKycFile(el,previewIdFor(id)))}})}
function renderStepper(){const s=document.getElementById('kycStepper');if(!s)return;s.innerHTML=Array.from({length:6},(_,i)=>`<div class="step-dot ${i+1===kycStep?'active':i+1<kycStep?'done':''}">${i+1}</div>`).join('')}
function showKycStep(n){kycStep=Math.max(1,Math.min(6,n));document.querySelectorAll('.kyc-step').forEach((x,i)=>x.classList.toggle('active',i===kycStep-1));renderStepper();document.querySelector('#kycModal .modal-box').scrollTop=0}
function validateKycStep(n){const req={1:['kycFather','kycMother','kycDob','kycProfession'],2:['kycPresent','kycPermanent','kycBdPhone'],3:['kycNid'],4:['kycShareNidFront','kycShareNidBack','kycMemberPhoto'],5:['kycNomineeName','kycNomineeNid','kycNomineeDob','kycNomineeRelation'],6:['kycNomNidFront','kycNomNidBack','kycNomineePhoto']}[n]||[];for(const id of req){const e=document.getElementById(id);if(!e||(!e.value&&!cropResults[id])){setKycMsg('এই ধাপের required তথ্য পূরণ করুন।',true);e&&e.focus();return false}}return true}
function nextKycStep(){if(validateKycStep(kycStep))showKycStep(kycStep+1)}function prevKycStep(){showKycStep(kycStep-1)}
function setKycMsg(t,bad=false){const x=document.getElementById('kycMsg');if(x){x.textContent=t||'';x.style.color=bad?'#d64545':'#1769e0'}}
function openKyc(){if(role!=='member')return;google.script.run.withSuccessHandler(k=>{if(k.completed&&!k.updatePermission){dataCache.kyc=k;return openProfile()}kycEditMode=!!(k.completed&&k.updatePermission);dataCache.kyc=k;document.getElementById('kycModal').classList.remove('hidden');fillKycForm(k);setupKycPreviews();showKycStep(1);setKycMsg(kycEditMode?'Admin approved update. You may update your KYC now.':'প্রথমবার KYC পূরণ করুন।')}).withFailureHandler(e=>alert(e.message||e)).getKYC(token,false)}
function fillKycForm(k){const set=(id,v)=>{const e=document.getElementById(id);if(e)e.value=v||''};set('kycMemberId',k.memberId||dataCache.memberId);set('kycMemberName',k.name||dataCache.name);['nidNumber','dob','fatherName','motherName','spouseName','maritalStatus','profession','email','bdPhone','whatsapp','overseasPhone','tinNumber','passportNumber','permanentAddress','presentAddress','nomineeName','nomineeNid','nomineeDob','nomineeRelation','nomineePhone','nomineeAddress','notes'].forEach(key=>{const map={nidNumber:'kycNid',dob:'kycDob',fatherName:'kycFather',motherName:'kycMother',spouseName:'kycSpouse',maritalStatus:'kycMarital',profession:'kycProfession',email:'kycEmail',bdPhone:'kycBdPhone',whatsapp:'kycWhatsapp',overseasPhone:'kycOverseasPhone',tinNumber:'kycTin',passportNumber:'kycPassport',permanentAddress:'kycPermanent',presentAddress:'kycPresent',nomineeName:'kycNomineeName',nomineeNid:'kycNomineeNid',nomineeDob:'kycNomineeDob',nomineeRelation:'kycNomineeRelation',nomineePhone:'kycNomineePhone',nomineeAddress:'kycNomineeAddress',notes:'kycNotes'};set(map[key],k[key])});Object.keys(cropResults).forEach(k=>delete cropResults[k]);}
function closeKyc(){document.getElementById('kycModal').classList.add('hidden');setKycMsg('');kycEditMode=false}
async function compressImageData(dataUrl,maxDim=1200,quality=.72){if(!dataUrl)return '';return await new Promise((resolve,reject)=>{const img=new Image();img.onload=()=>{let w=img.naturalWidth,h=img.naturalHeight,scale=Math.min(1,maxDim/Math.max(w,h));w=Math.max(1,Math.round(w*scale));h=Math.max(1,Math.round(h*scale));const c=document.createElement('canvas');c.width=w;c.height=h;const ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,w,h);ctx.drawImage(img,0,0,w,h);resolve(c.toDataURL('image/jpeg',quality))};img.onerror=reject;img.src=dataUrl})}
async function fileData(id,requiredImage=false){let data=cropResults[id]||'';const el=document.getElementById(id),f=el&&el.files&&el.files[0];if(!data&&f){if(f.type==='application/pdf')data=await pdfFirstPageToImage(f);else if(requiredImage)throw new Error('ছবিটি Camera/Gallery থেকে নির্বাচন করে Crop & Use করুন: '+id);else data=await readFileData(f)}if(id==='kycTinFile'&&data)data=await compressImageData(data,1200,.72);return data}
async function submitKyc(){if(!validateKycStep(6))return;setKycMsg('KYC save হচ্ছে এবং PDF তৈরি হচ্ছে...');try{const payload={shareholderName:document.getElementById('kycMemberName').value.trim(),nidNumber:document.getElementById('kycNid').value.trim(),dob:document.getElementById('kycDob').value,fatherName:document.getElementById('kycFather').value.trim(),motherName:document.getElementById('kycMother').value.trim(),spouseName:document.getElementById('kycSpouse').value.trim(),maritalStatus:document.getElementById('kycMarital').value,profession:document.getElementById('kycProfession').value.trim(),email:document.getElementById('kycEmail').value.trim(),bdPhone:document.getElementById('kycBdPhone').value.trim(),whatsapp:document.getElementById('kycWhatsapp').value.trim(),overseasPhone:document.getElementById('kycOverseasPhone').value.trim(),tinNumber:document.getElementById('kycTin').value.trim(),passportNumber:document.getElementById('kycPassport').value.trim(),permanentAddress:document.getElementById('kycPermanent').value.trim(),presentAddress:document.getElementById('kycPresent').value.trim(),nomineeName:document.getElementById('kycNomineeName').value.trim(),nomineeNid:document.getElementById('kycNomineeNid').value.trim(),nomineeDob:document.getElementById('kycNomineeDob').value,nomineeRelation:document.getElementById('kycNomineeRelation').value.trim(),nomineePhone:document.getElementById('kycNomineePhone').value.trim(),nomineeAddress:document.getElementById('kycNomineeAddress').value.trim(),notes:document.getElementById('kycNotes').value.trim(),shareholderNidFront:await fileData('kycShareNidFront',true),shareholderNidBack:await fileData('kycShareNidBack',true),memberPhoto:await fileData('kycMemberPhoto',true),tinCertificate:await fileData('kycTinFile'),passportCopy:await fileData('kycPassportFile'),nomineeNidFront:await fileData('kycNomNidFront',true),nomineeNidBack:await fileData('kycNomNidBack',true),nomineePhoto:await fileData('kycNomineePhoto',true),logoData:LOGO};google.script.run.withSuccessHandler(r=>{toast(kycEditMode?'KYC updated successfully':'KYC submitted successfully');closeKyc();loadDashboard()}).withFailureHandler(e=>setKycMsg('KYC Save Error: '+(e.message||e),true)).saveKYC(token,payload)}catch(e){setKycMsg(e.message||e,true)}}
function openProfile(){if(role!=='member')return;google.script.run.withSuccessHandler(k=>{dataCache.kyc=k;renderProfile(k);document.getElementById('sideOverlay').classList.add('open');document.getElementById('profilePanel').classList.add('open')}).withFailureHandler(e=>alert(e.message||e)).getKYC(token,true)}
function renderProfile(k){const item=(l,v,full=false)=>`<div class="profile-item ${full?'full':''}"><small>${esc(l)}</small><div>${esc(v||'—')}</div></div>`;const photo=k.photoData||'';document.getElementById('profileContent').innerHTML=`<div class="profile-head">${photo?`<img class="profile-large" src="${photo}">`:`<div class="profile-large" style="display:flex;align-items:center;justify-content:center;font-size:34px">👤</div>`}<div><h2 style="margin:0;color:var(--navy)">${esc(k.name||dataCache.name)}</h2><div class="muted">${esc(k.memberId||dataCache.memberId)}</div></div></div><div class="profile-section"><h4>Shareholder Information</h4><div class="profile-list">${item('NID Number',k.nidNumber)}${item('Date of Birth',k.dob)}${item('Father Name',k.fatherName)}${item('Mother Name',k.motherName)}${item('Spouse Name',k.spouseName)}${item('Marital Status',k.maritalStatus)}${item('Profession',k.profession)}${item('Bangladesh Phone',k.bdPhone)}${item('WhatsApp',k.whatsapp)}${item('Overseas Phone',k.overseasPhone)}${item('Email',k.email)}${item('TIN Number',k.tinNumber)}${item('Passport Number',k.passportNumber)}${item('Permanent Address',k.permanentAddress,true)}${item('Present Address',k.presentAddress,true)}</div></div><div class="profile-section"><h4>Nominee Information</h4><div class="profile-list">${item('Nominee Name',k.nomineeName)}${item('Nominee NID',k.nomineeNid)}${item('Date of Birth',k.nomineeDob)}${item('Relation',k.nomineeRelation)}${item('Phone',k.nomineePhone)}${item('Address',k.nomineeAddress,true)}</div></div><div class="profile-section"><h4>KYC Status</h4><div class="kyc-note">Submitted: <b>${esc(k.updated||'')}</b><br>Status: <b>${esc(k.completed?'Completed':'Pending')}</b>${k.updatePermission?'<br><span class="pill">Admin Approved: Update Enabled</span>':''}</div></div><div class="profile-actions">${k.completed?`<button class="green" onclick="downloadKycPdf()">📄 Download KYC PDF</button><button class="secondary" onclick="openPhotoModal()">📷 Change Profile Photo</button><button class="secondary" onclick="openRequest()">✉️ Request Update</button>${k.updatePermission?`<button class="gold" onclick="openKyc()">✏️ Update KYC Now</button>`:''}`:''}</div>`}
function closeProfile(){document.getElementById('sideOverlay').classList.remove('open');document.getElementById('profilePanel').classList.remove('open')}
function openRequest(){closeProfile();document.getElementById('requestText').value='';document.getElementById('requestMsg').textContent='';document.getElementById('requestModal').classList.remove('hidden')}
function closeRequest(){document.getElementById('requestModal').classList.add('hidden')}
function submitUpdateRequest(){const t=document.getElementById('requestText').value.trim();if(!t)return document.getElementById('requestMsg').textContent='পরিবর্তনের তথ্য লিখুন।';google.script.run.withSuccessHandler(()=>{document.getElementById('requestMsg').textContent='Request sent to Admin.';setTimeout(()=>{closeRequest();loadDashboard()},700)}).withFailureHandler(e=>document.getElementById('requestMsg').textContent=e.message||e).submitKycUpdateRequest(token,t)}
function kycRequestsTable(rows){if(!rows.length)return '<div class="empty">কোনো KYC update request নেই।</div>';return `<div class="table-wrap"><table><thead><tr><th>Member</th><th>Name</th><th>Request</th><th>Date</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.memberId)}</td><td>${esc(x.name)}</td><td style="white-space:normal;min-width:220px">${esc(x.request)}</td><td>${esc(x.requestDate)}</td><td><span class="pill ${x.status==='Pending'?'warn':''}">${esc(x.status)}</span></td><td><div class="admin-request-actions">${x.status==='Pending'?`<button class="green" onclick='reviewKycRequest(${JSON.stringify(x)})'>Approve</button><button class="danger" onclick='rejectKycRequest(${JSON.stringify(x)})'>Reject</button>`:`<span class="muted">${esc(x.adminNote||'Processed')}</span>`}</div></td></tr>`).join('')}</tbody></table></div>`}
function reviewKycRequest(x){const note=prompt('Approval note (optional):',x.adminNote||'');if(note===null)return;google.script.run.withSuccessHandler(()=>{toast('KYC update approved');loadDashboard()}).withFailureHandler(e=>alert(e.message||e)).markKycRequestReviewed(token,x.id,'Approved',note)}
function rejectKycRequest(x){const note=prompt('Reject reason:',x.adminNote||'');if(note===null)return;google.script.run.withSuccessHandler(()=>{toast('KYC update request rejected');loadDashboard()}).withFailureHandler(e=>alert(e.message||e)).markKycRequestReviewed(token,x.id,'Rejected',note)}
function openPhotoModal(){closeProfile();document.getElementById('photoModal').classList.remove('hidden');document.getElementById('photoMsg').textContent='';document.getElementById('profilePhotoInput').value='';document.getElementById('profilePhotoPreview').innerHTML='';delete cropResults.profilePhotoInput}
function closePhotoModal(){document.getElementById('photoModal').classList.add('hidden')}
function saveProfilePhoto(){const data=cropResults.profilePhotoInput;if(!data)return document.getElementById('photoMsg').textContent='ছবি নির্বাচন করে Crop & Use করুন।';document.getElementById('photoMsg').textContent='Saving...';google.script.run.withSuccessHandler(r=>{dataCache.kyc.photoData=r.photoData;document.getElementById('photoMsg').textContent='Profile photo updated.';toast('Profile photo updated');setTimeout(()=>{closePhotoModal();loadDashboard()},600)}).withFailureHandler(e=>document.getElementById('photoMsg').textContent=e.message||e).changeProfilePhoto(token,data)}
function downloadKycPdf(){const k=dataCache&&dataCache.kyc;if(!k)return alert('KYC PDF পাওয়া যায়নি।');if(k.pdfData){const a=document.createElement('a');a.href=k.pdfData;a.download=(dataCache.memberId||'Member')+'_KYC.pdf';document.body.appendChild(a);a.click();a.remove();}else if(k.pdfUrl){const w=window.open('about:blank','_blank');if(!w)return alert('Popup blocked. Please allow popups for this site, then try again.');w.location.href=k.pdfUrl;}else alert('KYC PDF পাওয়া যায়নি।')}
function printStatement(){
  // Open the print window immediately from the user's click so Chrome does not block it.
  const w=window.open('about:blank','_blank');
  if(!w){alert('Popup blocked. Please allow popups for this site, then try again.');return;}
  w.document.write('<html><body style="font-family:Arial;padding:30px;color:#17324b"><h3>Preparing statement...</h3><p>Please wait...</p></body></html>');
  w.document.close();
  google.script.run.withSuccessHandler(x=>{
    try{
      w.document.open();
      w.document.write(`<!doctype html><html><head><title>Member Statement - ${esc(x.memberId)}</title><style>body{font-family:Arial,sans-serif;padding:35px;color:#17324b}img{width:300px;max-width:80%}h1{color:#0b3d91}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{border:1px solid #dce6f2;padding:9px}th{background:#eef5ff;text-align:left}.total{font-size:22px;font-weight:800;color:#10a85a;margin-top:20px}</style></head><body><img src="${LOGO}"><h1>Member Statement</h1><p><b>Member:</b> ${esc(x.name)}<br><b>Member ID:</b> ${esc(x.memberId)}<br><b>Mobile:</b> ${esc(x.mobile||'')}</p><table><tr><th>Date</th><th>Type</th><th>Amount</th><th>Note</th></tr>${x.transactions.map(t=>`<tr><td>${esc(t.date)}</td><td>${esc(t.type)}</td><td>৳ ${money(t.amount)}</td><td>${esc(t.note)}</td></tr>`).join('')}</table><div class="total">Net Deposit: ৳ ${money(x.total)}</div><div style="margin-top:16px;padding:12px;border:1px solid #dce6f2;border-radius:10px;background:#f7fbff"><b>Institutional Account Summary</b><br>Main Bank Balance: ৳ ${money(x.mainBank)}<br>FDR Balance: ৳ ${money(x.fdrBalance)}<br>Total Institutional Funds: ৳ ${money(x.totalInstitutional)}</div><p style="color:#6b7a90">Together We Grow</p></body></html>`);
      w.document.close();
      setTimeout(()=>{try{w.focus();w.print();}catch(e){}},500);
    }catch(err){try{w.document.body.innerHTML='<p>Statement load failed.</p>';}catch(e){}}
  }).withFailureHandler(e=>{try{w.close();}catch(_){ } alert(e.message||e)}).getStatement(token);
}
function doLogout(){if(token)google.script.run.logout(token);token='';role='';dataCache=null;document.getElementById('app').style.display='none';document.getElementById('loginView').classList.remove('hidden');document.getElementById('memberPass').value='';document.getElementById('adminPin').value='';msg('')}
